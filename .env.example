# Copy to .env and adjust as needed. These are read by foodsnap/settings.py.

# Production: generate a real random key (e.g. `python -c "import secrets; print(secrets.token_urlsafe(50))"`)
DJANGO_SECRET_KEY=change-me

# Production: set to 0 / False. Never run DEBUG on a public server.
DJANGO_DEBUG=1

# Production: your domain(s), comma-separated, e.g. foodsnap.example.com,www.foodsnap.example.com
DJANGO_ALLOWED_HOSTS=*

# Optional: alternate sqlite filename
# DJANGO_DB_NAME=db.sqlite3

# Gemini API Key for server-side AI dish verification & image search
GEMINI_API_KEY=
